/*--------------------------------------------
SnakeCase algorithm example
--------------------------------------------*/
#include <cctype>
#include <iostream>
#include <string>
#include <cctype>

using namespace std;

string SnakeCase(string str) 
{
  string temp;
  string resultText;
  for (char c : str)
  {
    if (isalpha(c))
    {
      temp += tolower(c);
    }
    else
    {
      resultText += temp + "_";
      temp = "";
    }
  } 
  resultText += temp;
  return resultText;
}

int main(void) { 
   
  cout << SnakeCase(coderbyteInternalStdinFunction(stdin));
  return 0;
    
}

/*-------------------------------------------------------------
FizzBuzz function
-------------------------------------------------------------*/
string FizzBuzz(int num) {
  
  // code goes here 
  stringstream result; 
  for (int i = 1; i <= num; ++i)
  {
    if (i % 3 == 0 && i % 5 == 0)
    {
      result << "FizzBuzz";
    }
    else if (i % 3 == 0)
    {
      result << "Fizz";
    }
    else if (i % 5 == 0)
    {
      result << "Buzz";
    }
    else {
      result << i;
    }
    result << " ";
  }
  return result.str();
}
/*-------------------------------------------------------------
Qt de emit ile bağlantı kurulan fonksiyon QObject::connect
çağrısının durumuna göre bir kere veya birden fazla kere çağrılabilir 
örneğin aşağıdaki gibi bir örnekte 11 kere değil 2 kere çağrılır çünkü
burada uniqueconnection kullanımı söz konusudur.
-------------------------------------------------------------*/
#include <QCoreApplication>
#include "dog.h"
#include "owner.h"

int main(int argc, char *argv[])
{
    QCoreApplication a(argc, argv);

    Owner owner;
    Dog dog;

    QObject::connect(&owner, &Owner::treats, &dog, &Dog::treats);
    
    for (int i = 0; i < 10; ++i)
    {
        QObject::connect(&owner, &Owner::treats, &dog, &Dog::treats, Qt::UniqueConnection); // Unique connection
    }

    owner.giveSnacks();

    return a.exec();
}
